# 로컬 실행용 설정. 실제 값이 담긴 .env 는 커밋하지 않는다.
# CI 에서는 이 값들을 GitHub Secrets 로 주입한다.

# Discord 웹훅 (비우면 전송 단계가 실패한다)
DISCORD_TIL_WEBHOOK=

# 카드를 만들 CLI: codex | claude
REVIEW_PROVIDER=codex

# --- codex 경로 ---
# 로컬은 `codex login` 으로 이미 인증돼 있으면 따로 설정할 게 없다.
CODEX_MODEL=gpt-5.6-sol

# --- claude 경로 ---
# `claude setup-token` 으로 발급한 구독 토큰. 로컬은 이미 로그인돼 있으면 비워도 된다.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=fable

# 방금 푼 문제를 몇 시간 동안 출제에서 뺄지. 0 이면 전부 포함 (새벽에 푼 것도 그날 아침에 나온다).
REVIEW_MIN_AGE_HOURS=0

# 운영 환경. production 이 아니면 Discord 사용자명에 배지가 붙는다 (복습 [DEV])
APP_ENVIRONMENT=production
